{
  "name": "rapigents",
  "version": "1.0.0",
  "private": true,
  "description": "Rapigents portfolio — AI workflow automation demos built in n8n.",
  "scripts": {
    "postinstall": "node scripts/patch-opennext-turbopack.js",
    "dev": "next dev",
    "build": "node scripts/patch-opennext-turbopack.js && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --import ./tests/register.mjs --test tests/*.test.ts && node --no-warnings --import ./tests/load-aliases.mjs --test \"tests/**/*.test.mts\" && python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:unit": "node --no-warnings --import ./tests/register.mjs --test tests/*.test.ts",
    "test:3d": "node --no-warnings --import ./tests/load-aliases.mjs --test \"tests/**/*.test.mts\"",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "worker": "node scripts/patch-opennext-turbopack.js && next build && opennextjs-cloudflare build --skipNextBuild"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
