# =============================================================================
# Fyndra — environment variables
#
# Copy to `.env.local` for local development. NEVER commit a filled-in copy:
# `.env*` is git-ignored on purpose.
#
# Every integration is optional. With nothing set the app runs on the seed
# catalogue with deterministic recommendations and says so — it never claims an
# integration is connected when it is not.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical origin used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admitad (affiliate network) ----------------------------------------------
# Server-side only. Create these at:
#   store.admitad.com -> Account -> Settings -> Credentials -> "Show credentials"
# Required for OAuth. Never prefix with NEXT_PUBLIC_.
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=

# Your publisher ad space id (Admitad calls it "website"). Required for:
#   - listing programmes connected to your account
#   - generating deeplinks
#   - AliExpress WW availability
ADMITAD_WEBSITE_ID=

# The advertiser programme id to import from (e.g. AliExpress WW).
# Optional: import routes accept `campaignId` per request, which is preferable
# when you import from more than one programme.
ADMITAD_CAMPAIGN_ID=

# Optional overrides. Leave blank in normal operation.
#
# ADMITAD_ACCESS_TOKEN — only if you already hold a bearer token obtained out of
# band. When set, OAuth is skipped and the token is used verbatim; it will not
# be refreshed, so prefer the client credentials above.
ADMITAD_ACCESS_TOKEN=
#
# ADMITAD_SCOPE — space- or comma-separated scopes to request. Defaults to the
# full documented publisher set (advcampaigns, advcampaigns_for_website,
# websites, deeplink_generator, validate_links, statistics,
# aliexpress_commission, private_data, public_data).
ADMITAD_SCOPE=
#
# ADMITAD_FEED_URL — a fixed product-feed download link, if you would rather
# pin one than resolve it from the ad-space programme object.
ADMITAD_FEED_URL=

# --- Supabase (storage) -------------------------------------------------------
# Server-side only. Without these, imports are parsed and validated but not
# stored, and the site serves the seed catalogue.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS for admin write paths. NEVER expose to the browser. The service
# role key is what the import pipeline and catalogue reads use.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI enrichment (optional) -------------------------------------------------
# Enables headline/description generation for imported products. Product facts
# are never generated. Without it, quality flags are still computed locally.
GROQ_API_KEY=

# --- n8n automation -----------------------------------------------------------
# Shared secret for `/api/n8n/*`. When unset, those endpoints refuse all traffic
# (fail closed). Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=