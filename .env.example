# Free model routing runs first. Keep paid-model usage disabled for a zero-budget setup.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID=false

# Optional independent fallbacks. Create keys from each provider's official console.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

NEXT_PUBLIC_SITE_URL=https://rapigents.com
