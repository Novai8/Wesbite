{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wesbite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "rapigents.com/*",
      "zone_name": "rapigents.com"
    },
    {
      "pattern": "www.rapigents.com/*",
      "zone_name": "rapigents.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
